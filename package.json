{
  "name": "grahalens",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:beta": "EXPO_PUBLIC_IAP_MODE=mock jest --runInBand && node scripts/test-beta.mjs",
    "seed": "node scripts/seed.mjs"
